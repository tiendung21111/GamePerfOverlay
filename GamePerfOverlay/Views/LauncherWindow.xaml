<Window x:Class="GamePerfOverlay.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GamePerfOverlay.ViewModels"
        xmlns:models="clr-namespace:GamePerfOverlay.Models"
        mc:Ignorable="d"
        Title="Game Hub &amp; Launcher"
        Icon="pack://application:,,,/Assets/app.png"
        Height="700" Width="1060"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#0b0e14"
        Foreground="#e2e8f0"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Common Button Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Platform Filter Button Style -->
        <Style x:Key="SidebarTabButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#182030"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AllTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarTabButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAllSelected}" Value="True">
                    <Setter Property="Background" Value="#14261c"/>
                    <Setter Property="BorderBrush" Value="#10ff50"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SteamTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarTabButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSteamSelected}" Value="True">
                    <Setter Property="Background" Value="#14261c"/>
                    <Setter Property="BorderBrush" Value="#10ff50"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RiotTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarTabButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRiotSelected}" Value="True">
                    <Setter Property="Background" Value="#14261c"/>
                    <Setter Property="BorderBrush" Value="#10ff50"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EpicTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarTabButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEpicSelected}" Value="True">
                    <Setter Property="Background" Value="#14261c"/>
                    <Setter Property="BorderBrush" Value="#10ff50"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StandaloneTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarTabButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStandaloneSelected}" Value="True">
                    <Setter Property="Background" Value="#14261c"/>
                    <Setter Property="BorderBrush" Value="#10ff50"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar -->
            <RowDefinition Height="Auto"/> <!-- Scan Progress Bar -->
            <RowDefinition Height="*"/>    <!-- Main Body -->
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER BAR -->
        <Border Grid.Row="0" Background="#111622" BorderBrush="#1e293b" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Logo / Title -->
                    <ColumnDefinition Width="*"/>    <!-- Search -->
                    <ColumnDefinition Width="Auto"/> <!-- Actions -->
                </Grid.ColumnDefinitions>

                <!-- Logo & Subtitle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#10ff50" Margin="0,0,12,0">
                        <Image Source="pack://application:,,,/Assets/app.png" Margin="4"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="GAME HUB" FontWeight="Black" FontSize="16" Foreground="White"/>
                            <Border Background="#1a3a25" BorderBrush="#10ff50" BorderThickness="1" CornerRadius="4" Margin="8,0,0,0" Padding="5,1">
                                <TextBlock Text="LAUNCHER" FontSize="9" FontWeight="Bold" Foreground="#10ff50"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="All-in-One Game Launcher &amp; Performance Overlay" FontSize="11" Foreground="#64748b"/>
                    </StackPanel>
                </StackPanel>

                <!-- Search Input -->
                <Border Grid.Column="1" Margin="24,0" Background="#182030" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" MaxWidth="380" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" Foreground="#64748b" FontSize="11" VerticalAlignment="Center" Margin="10,0,4,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="Transparent" BorderThickness="0" Foreground="White" FontSize="13" 
                                 VerticalAlignment="Center" Padding="4,7" 
                                 d:Text="Tìm kiếm game..."/>
                    </Grid>
                </Border>

                <!-- Top Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ScanCommand}" Style="{StaticResource ActionButton}" 
                            Background="#182030" BorderBrush="#10ff50" BorderThickness="1" Foreground="#10ff50" 
                            FontWeight="SemiBold" FontSize="12" Padding="12,7" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" Margin="0,0,4,0"/>
                            <TextBlock Text="Quét tìm Game"/>
                        </StackPanel>
                    </Button>

                    <Button Click="AddCustomGame_Click" Style="{StaticResource ActionButton}" 
                            Background="#182030" BorderBrush="#334155" BorderThickness="1" Foreground="#cbd5e1" 
                            FontSize="12" Padding="10,7" Margin="0,0,8,0">
                        <TextBlock Text="+ Thêm .exe"/>
                    </Button>

                    <Button Click="AddSampleGames_Click" Style="{StaticResource ActionButton}" 
                            Background="#182030" BorderBrush="#334155" BorderThickness="1" Foreground="#94a3b8" 
                            FontSize="12" Padding="10,7" Margin="0,0,12,0" ToolTip="Nạp 5 tựa game mẫu nếu máy chưa có sẵn game">
                        <TextBlock Text="Demo Games"/>
                    </Button>

                    <!-- Interactive HUD & Window Controls -->
                    <Button Click="ToggleOverlayBtn_Click" Style="{StaticResource ActionButton}" 
                            Background="#14261c" BorderBrush="#10ff50" BorderThickness="1" Foreground="#10ff50" 
                            FontWeight="SemiBold" FontSize="12" Padding="10,7" Margin="0,0,8,0"
                            ToolTip="Bật / Tắt ngay Overlay FPS &amp; Phần cứng trên màn hình (Mặc định: Alt + Q)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,5,0"/>
                            <TextBlock Text="Bật/Tắt HUD"/>
                        </StackPanel>
                    </Button>

                    <Button Click="OpenHotkeySettings_Click" Style="{StaticResource ActionButton}" 
                            Background="#182030" BorderBrush="#334155" BorderThickness="1" Foreground="#94a3b8" 
                            FontSize="12" Padding="8,7" Margin="0,0,8,0"
                            ToolTip="Đổi phím tắt bật/tắt Overlay">
                        <TextBlock Text="⚙️"/>
                    </Button>

                    <Button Click="ExitApp_Click" Style="{StaticResource ActionButton}" 
                            Background="#2d1515" BorderBrush="#ef4444" BorderThickness="1" Foreground="#f87171" 
                            FontWeight="SemiBold" FontSize="12" Padding="10,7"
                            ToolTip="Thoát hoàn toàn ứng dụng Game Performance Overlay">
                        <TextBlock Text="✕ Thoát"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. STATUS / SCANNING BANNER -->
        <Border Grid.Row="1" Background="#064e3b" BorderBrush="#10ff50" BorderThickness="0,0,0,1" 
                Padding="16,6" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⏳" Foreground="#10ff50" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#10ff50" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- 3. MAIN WORKSPACE -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/> <!-- Sidebar Categories -->
                <ColumnDefinition Width="*"/>   <!-- Game Grid -->
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="#0e131d" BorderBrush="#1e293b" BorderThickness="0,0,1,0" Padding="12,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="NỀN TẢNG" FontSize="11" FontWeight="Bold" Foreground="#94a3b8" Margin="8,0,0,10"/>

                    <StackPanel Grid.Row="1">
                        <Button Style="{StaticResource AllTabButtonStyle}" Command="{Binding SelectPlatformCommand}" CommandParameter="All">
                            <Grid Margin="2,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#10ff50" Margin="0,0,10,0"/>
                                    <TextBlock Text="Tất cả game" FontSize="13" FontWeight="SemiBold" Foreground="#f8fafc" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1e293b" CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="{Binding TotalGameCount}" FontSize="11" FontWeight="Bold" Foreground="#cbd5e1"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource SteamTabButtonStyle}" Command="{Binding SelectPlatformCommand}" CommandParameter="Steam">
                            <Grid Margin="2,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#38bdf8" Margin="0,0,10,0"/>
                                    <TextBlock Text="Steam" FontSize="13" FontWeight="SemiBold" Foreground="#f8fafc" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1e293b" CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="{Binding SteamGameCount}" FontSize="11" FontWeight="Bold" Foreground="#cbd5e1"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource RiotTabButtonStyle}" Command="{Binding SelectPlatformCommand}" CommandParameter="Riot">
                            <Grid Margin="2,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#f43f5e" Margin="0,0,10,0"/>
                                    <TextBlock Text="Riot Games" FontSize="13" FontWeight="SemiBold" Foreground="#f8fafc" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1e293b" CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="{Binding RiotGameCount}" FontSize="11" FontWeight="Bold" Foreground="#cbd5e1"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource EpicTabButtonStyle}" Command="{Binding SelectPlatformCommand}" CommandParameter="Epic">
                            <Grid Margin="2,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#94a3b8" Margin="0,0,10,0"/>
                                    <TextBlock Text="Epic Games" FontSize="13" FontWeight="SemiBold" Foreground="#f8fafc" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1e293b" CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="{Binding EpicGameCount}" FontSize="11" FontWeight="Bold" Foreground="#cbd5e1"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource StandaloneTabButtonStyle}" Command="{Binding SelectPlatformCommand}" CommandParameter="Standalone">
                            <Grid Margin="2,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#a855f7" Margin="0,0,10,0"/>
                                    <TextBlock Text="Khác / .exe" FontSize="13" FontWeight="SemiBold" Foreground="#f8fafc" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1e293b" CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="{Binding StandaloneGameCount}" FontSize="11" FontWeight="Bold" Foreground="#cbd5e1"/>
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Quick Info -->
                    <Border Grid.Row="2" Background="#141a27" CornerRadius="8" Padding="12" BorderBrush="#1e293b" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="TRẠNG THÁI HỆ THỐNG" FontSize="9" FontWeight="Bold" Foreground="#94a3b8" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="6" Height="6" CornerRadius="3" Background="#10ff50" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Overlay HUD: Sẵn sàng" FontSize="11" Foreground="#f1f5f9" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="Khi vào game: Cửa sổ tự thu gọn xuống Tray" FontSize="10" Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Button Click="ToggleOverlayBtn_Click" Style="{StaticResource ActionButton}"
                                    Background="#1e293b" BorderBrush="#3b82f6" BorderThickness="1"
                                    Padding="8,6" HorizontalAlignment="Stretch">
                                <TextBlock Text="📊 Bật / Tắt Overlay HUD" FontSize="11" FontWeight="SemiBold" Foreground="#38bdf8"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT MAIN GAME GRID -->
            <Grid Grid.Column="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" FontSize="11" Foreground="#94a3b8" Margin="4,0,0,8"/>

                <!-- Game Cards View -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding DisplayedGames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:GameEntry}">
                                <Border Width="230" Height="270" Margin="10" Background="#131924" 
                                        BorderBrush="#1e293b" BorderThickness="1" CornerRadius="12" 
                                        ClipToBounds="True">
                                    <Border.ContextMenu>
                                        <ContextMenu Background="#131924" Foreground="White" BorderBrush="#1e293b">
                                            <MenuItem Header="▶ Khởi chạy" 
                                                      Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                      CommandParameter="{Binding}" Foreground="#10ff50" FontWeight="SemiBold"/>
                                            <Separator Background="#1e293b"/>
                                            <MenuItem Header="🗑 Xóa khỏi thư viện" 
                                                      Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                      CommandParameter="{Binding}" Foreground="#f87171"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="140"/> <!-- Cover Art -->
                                            <RowDefinition Height="*"/>   <!-- Info & Action -->
                                        </Grid.RowDefinitions>

                                        <!-- Cover Image or Fallback Header -->
                                        <Border Grid.Row="0" Background="#0f172a" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill" HorizontalAlignment="Center"/>
                                                <!-- Gradient Shadow -->
                                                <Border Background="#131924" Opacity="0.3"/>

                                                <!-- Platform Badge -->
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" 
                                                        Margin="8" Background="#090d16" BorderBrush="#334155" BorderThickness="1" 
                                                        CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding Platform}" FontSize="9" FontWeight="Bold" Foreground="#e2e8f0"/>
                                                </Border>

                                                <!-- Quick Remove Button -->
                                                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="8"
                                                        Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Xóa game khỏi thư viện"
                                                        Background="#000000" Opacity="0.8" Foreground="#94a3b8"
                                                        BorderThickness="0" Padding="6,2" Cursor="Hand">
                                                    <TextBlock Text="✕" FontSize="10" FontWeight="Bold"/>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- Details & Play Button -->
                                        <Grid Grid.Row="1" Margin="12,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="Bold" FontSize="13" 
                                                       Foreground="White" TextTrimming="CharacterEllipsis"/>

                                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                <TextBlock FontSize="11" Foreground="#94a3b8">
                                                    <Run Text="Lần chơi: "/>
                                                    <Run Text="{Binding PlayCount, StringFormat='{}{0} lần'}" FontWeight="SemiBold" Foreground="#e2e8f0"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- PLAY BUTTON -->
                                            <Button Grid.Row="2" Style="{StaticResource ActionButton}" 
                                                    Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                    CommandParameter="{Binding}"
                                                    Background="#10ff50" Foreground="#000000" FontWeight="Bold" 
                                                    FontSize="12" Padding="0,7">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="▶ " FontSize="10" Margin="0,1,2,0"/>
                                                    <TextBlock Text="CHƠI NGAY"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
