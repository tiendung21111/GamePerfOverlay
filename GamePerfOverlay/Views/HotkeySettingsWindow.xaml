<Window x:Class="GamePerfOverlay.Views.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt phím tắt - Game Performance Overlay"
        Icon="pack://application:,,,/Assets/app.png"
        Width="430" Height="290"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#181818"
        Foreground="#f0f0f0"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="TỔ HỢP PHÍM TẮT BẬT / TẮT OVERLAY" 
                   FontWeight="Bold" FontSize="14" Foreground="#10ff50" Margin="0,0,0,6"/>

        <!-- Instruction -->
        <TextBlock Grid.Row="1" 
                   Text="Nhấp vào ô bên dưới rồi nhấn tổ hợp phím bạn muốn gán (Ví dụ: F12, Alt+Z, Ctrl+Shift+O, Ctrl+D+M...)" 
                   FontSize="12" Foreground="#999999" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <!-- Hotkey Display / Capture Box -->
        <Border Grid.Row="2" x:Name="KeyCaptureBorder" 
                Background="#222222" BorderBrush="#10ff50" BorderThickness="1.5" CornerRadius="6" 
                Height="54" Focusable="True" Cursor="Hand"
                MouseDown="KeyCaptureBorder_MouseDown"
                PreviewKeyDown="KeyCaptureBorder_PreviewKeyDown">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="HotkeyDisplayText" Text="Ctrl + D + M" 
                           FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="#10ff50"/>
            </StackPanel>
        </Border>

        <!-- Status hint -->
        <TextBlock Grid.Row="3" x:Name="StatusHintText"
                   Text="Đang ghi nhận: Bấm chuột vào ô trên rồi nhấn tổ hợp phím mới." 
                   FontSize="11" Foreground="#666666" Margin="0,8,0,0" HorizontalAlignment="Center"/>

        <!-- Action buttons -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Mặc định (Ctrl + D + M)" 
                    Background="#2d2d2d" Foreground="#cccccc" Padding="10,8" FontSize="12"
                    Click="ResetDefaultButton_Click"/>

            <Button Grid.Column="2" Content="Hủy" 
                    Background="#2d2d2d" Foreground="#cccccc" Padding="14,8" FontSize="12" Margin="0,0,8,0"
                    Click="CancelButton_Click"/>

            <Button Grid.Column="3" Content="Lưu phím tắt" 
                    Background="#10ff50" Foreground="#000000" FontWeight="Bold" Padding="16,8" FontSize="12"
                    Click="SaveButton_Click"/>
        </Grid>
    </Grid>
</Window>
